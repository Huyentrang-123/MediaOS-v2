# TikHub API — Đăng ký tại tikhub.io, lấy token từ Dashboard → API
# Để trống nếu không dùng TikHub
TIKHUB_API_KEY=

# Bật tìm kiếm trả phí (TikHub/Douyin) — mặc định false (zero-cost mode)
# Chỉ set true khi TIKHUB_API_KEY hợp lệ và có đủ credit
ENABLE_PAID_SEARCH=false

# Port (Render tự set biến PORT; để 3001 khi chạy local)
# PORT=3001
